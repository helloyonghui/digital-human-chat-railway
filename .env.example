# Railway部署环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 服务器配置
PORT=3000
NODE_ENV=production

# LiveKit配置 (必填)
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_secret_here  
LIVEKIT_WS_URL=wss://your-livekit-server.livekit.cloud

# 数字人后端API配置 (可选，如果有独立的数字人服务)
DIGITAL_HUMAN_API_URL=https://your-digital-human-api.com
DIGITAL_HUMAN_API_KEY=your_api_key_here

# CORS配置 (可选)
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://another-domain.com

# 安全配置
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here

# 日志级别
LOG_LEVEL=info